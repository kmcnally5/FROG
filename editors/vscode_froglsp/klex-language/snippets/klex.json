{

  // ───────────────────────────────────────────────────────────────────────────
  //  Static snippets for kLex / FROG.
  //
  //  These complement the LSP-side completion snippets shipped by froglsp.
  //  The LSP owns the canonical control-flow / declaration idioms (fn,
  //  if, while, for-in, switch, struct, enum, import, safe, async, etc),
  //  served with rich markdown documentation. This file keeps the
  //  long-tail wrappers: channel ops, file I/O, string/hash helpers,
  //  type conversions, and the multi-line patterns the LSP doesn't try
  //  to express in a single snippet body.
  //
  //  RULE: never teach a pattern the lint flags as an antipattern (push()
  //  in loops, etc). Pre-allocate with makeArray instead.
  // ───────────────────────────────────────────────────────────────────────────

  // ─── CONTROL FLOW (LSP-uncovered variants only) ──────────────────────────────

  "for-in with index": {
    "prefix": "fori",
    "body": ["for ${1:i}, ${2:val} in ${3:collection} {", "\t$0", "}"],
    "description": "for-in loop with index variable (single-var form is provided by the LSP via `for-in`)"
  },

  "return": {
    "prefix": "return",
    "body": ["return $0"],
    "description": "return statement"
  },

  // ─── DECLARATIONS (LSP-uncovered) ───────────────────────────────────────────

  "let": {
    "prefix": "let",
    "body": ["let ${1:name} = $0"],
    "description": "let binding (current scope only)"
  },

  "const": {
    "prefix": "const",
    "body": ["const ${1:NAME} = $0"],
    "description": "constant declaration (immutable)"
  },

  // ─── ASYNC / CONCURRENCY ─────────────────────────────────────────────────────

  "async": {
    "prefix": "async",
    "body": ["let ${1:task} = async(${2:fn}${3:, args})"],
    "description": "launch a task asynchronously (single-line form; for inline fn, use the LSP `async` snippet)"
  },

  "await": {
    "prefix": "await",
    "body": ["await(${1:task})"],
    "description": "block until task completes and return its result"
  },

  "channel": {
    "prefix": "channel",
    "body": ["let ${1:ch} = channel()"],
    "description": "unbuffered channel"
  },

  "buffered channel": {
    "prefix": "chanb",
    "body": ["let ${1:ch} = channel(${2:64})"],
    "description": "buffered channel with capacity"
  },

  "send": {
    "prefix": "send",
    "body": ["send(${1:ch}, ${2:value})"],
    "description": "send a value into a channel"
  },

  "recv": {
    "prefix": "recv",
    "body": ["${1:val}, ${2:ok} = recv(${3:ch})"],
    "description": "receive a value from a channel"
  },

  "close": {
    "prefix": "close",
    "body": ["close(${1:ch})"],
    "description": "close a channel"
  },

  "cancel": {
    "prefix": "cancel",
    "body": ["cancel(${1:ch})"],
    "description": "cancel a channel (signal done to producer)"
  },

  "select": {
    "prefix": "select",
    "body": [
      "select {",
      "case ${1:val} = recv(${2:ch}):",
      "\t$3",
      "default:",
      "\t$0",
      "}"
    ],
    "description": "select statement for channel operations"
  },

  // ─── OUTPUT ──────────────────────────────────────────────────────────────────

  "println": {
    "prefix": "println",
    "body": ["println($0)"],
    "description": "print values each on its own line"
  },

  "print": {
    "prefix": "print",
    "body": ["print($0)"],
    "description": "print values with no newline"
  },

  "format": {
    "prefix": "format",
    "body": ["format(\"${1:template}\", ${2:args})"],
    "description": "format a string with positional placeholders"
  },

  // ─── ARRAY OPERATIONS ────────────────────────────────────────────────────────
  //  NOTE: push/concat are NOT shipped here. Loops should pre-allocate
  //  with makeArray() and index by position — see the lint diagnostic
  //  PUSH_ANTIPATTERN. push() one-shot (outside loops) is fine but we
  //  don't surface it as a Tab-completable snippet.

  "len": {
    "prefix": "len",
    "body": ["len(${1:collection})"],
    "description": "number of elements in array, string, or hash"
  },

  "pop": {
    "prefix": "pop",
    "body": ["pop(${1:arr})"],
    "description": "new array without last element (non-mutating)"
  },

  "makeArray": {
    "prefix": "makeArray",
    "body": ["makeArray(${1:size}, ${2:default})"],
    "description": "create array of size elements, each initialized to default (the canonical kLex pre-allocation idiom — use INSTEAD of push() inside loops)"
  },

  "range": {
    "prefix": "range",
    "body": ["range(${1:n})"],
    "description": "array of integers [0, n)"
  },

  "range start/stop": {
    "prefix": "ranges",
    "body": ["range(${1:start}, ${2:stop})"],
    "description": "array of integers [start, stop)"
  },

  "range start/stop/step": {
    "prefix": "rangest",
    "body": ["range(${1:start}, ${2:stop}, ${3:step})"],
    "description": "array of integers with step"
  },

  "slice": {
    "prefix": "slice",
    "body": ["slice(${1:arr}, ${2:start}, ${3:end})"],
    "description": "sub-array by 0-based index, end exclusive"
  },

  "filter": {
    "prefix": "filter",
    "body": ["filter(${1:arr}, fn(${2:x}) { $0 })"],
    "description": "return elements where predicate is true"
  },

  "map": {
    "prefix": "map",
    "body": ["map(${1:arr}, fn(${2:x}) { $0 })"],
    "description": "apply function to every element, return new array"
  },

  "reduce": {
    "prefix": "reduce",
    "body": ["reduce(${1:arr}, fn(${2:acc}, ${3:x}) { $0 }, ${4:init})"],
    "description": "fold array to a single value"
  },

  // ─── STRING OPERATIONS ───────────────────────────────────────────────────────

  "split": {
    "prefix": "split",
    "body": ["split(${1:str}, \"${2:sep}\")"],
    "description": "split string on separator, returns array"
  },

  "join": {
    "prefix": "join",
    "body": ["join(${1:arr}, \"${2:sep}\")"],
    "description": "join array of strings with separator"
  },

  "substr": {
    "prefix": "substr",
    "body": ["substr(${1:str}, ${2:start}, ${3:end})"],
    "description": "substring by 0-based index, end exclusive"
  },

  "upper": {
    "prefix": "upper",
    "body": ["upper(${1:str})"],
    "description": "convert string to uppercase"
  },

  "lower": {
    "prefix": "lower",
    "body": ["lower(${1:str})"],
    "description": "convert string to lowercase"
  },

  "trim": {
    "prefix": "trim",
    "body": ["trim(${1:str})"],
    "description": "remove leading and trailing whitespace"
  },

  "replace": {
    "prefix": "replace",
    "body": ["replace(${1:str}, \"${2:old}\", \"${3:new}\")"],
    "description": "replace all occurrences of old with new"
  },

  "indexOf": {
    "prefix": "indexOf",
    "body": ["indexOf(${1:str}, \"${2:sub}\")"],
    "description": "index of first occurrence, or -1 if not found"
  },

  "startsWith": {
    "prefix": "startsWith",
    "body": ["startsWith(${1:str}, \"${2:prefix}\")"],
    "description": "true if string starts with prefix"
  },

  "endsWith": {
    "prefix": "endsWith",
    "body": ["endsWith(${1:str}, \"${2:suffix}\")"],
    "description": "true if string ends with suffix"
  },

  // ─── HASH OPERATIONS ─────────────────────────────────────────────────────────

  "keys": {
    "prefix": "keys",
    "body": ["keys(${1:hash})"],
    "description": "array of all keys in hash"
  },

  "values": {
    "prefix": "values",
    "body": ["values(${1:hash})"],
    "description": "array of all values in hash"
  },

  "hasKey": {
    "prefix": "hasKey",
    "body": ["hasKey(${1:hash}, \"${2:key}\")"],
    "description": "true if key exists in hash"
  },

  "delete": {
    "prefix": "delete",
    "body": ["delete(${1:hash}, \"${2:key}\")"],
    "description": "new hash without the given key (non-mutating)"
  },

  // ─── TYPE CONVERSION ─────────────────────────────────────────────────────────

  "str": {
    "prefix": "str",
    "body": ["str(${1:val})"],
    "description": "convert value to string"
  },

  "int": {
    "prefix": "int",
    "body": ["int(${1:val})"],
    "description": "convert value to integer"
  },

  "float": {
    "prefix": "float",
    "body": ["float(${1:val})"],
    "description": "convert value to float"
  },

  "type": {
    "prefix": "type",
    "body": ["type(${1:val})"],
    "description": "returns runtime type name as a string"
  },

  // ─── ERROR HANDLING ──────────────────────────────────────────────────────────

  "error": {
    "prefix": "error",
    "body": ["error(\"${1:code}\", \"${2:message}\")"],
    "description": "create a user error value"
  },

  "isError": {
    "prefix": "isError",
    "body": ["isError(${1:val})"],
    "description": "true if val is an error object"
  },

  "assert": {
    "prefix": "assert",
    "body": ["assert(${1:condition}, \"${2:message}\")"],
    "description": "halt with message if condition is false"
  },

  // ─── FILE I/O ────────────────────────────────────────────────────────────────

  "readFile": {
    "prefix": "readFile",
    "body": ["${1:content}, ${2:err} = readFile(\"${3:path}\")"],
    "description": "read entire file as a string"
  },

  "writeFile": {
    "prefix": "writeFile",
    "body": ["${1:_, err} = writeFile(\"${2:path}\", ${3:content})"],
    "description": "write string to file (overwrites)"
  },

  "appendFile": {
    "prefix": "appendFile",
    "body": ["${1:_, err} = appendFile(\"${2:path}\", ${3:content})"],
    "description": "append string to file"
  },

  // ─── SYSTEM ──────────────────────────────────────────────────────────────────

  "input": {
    "prefix": "input",
    "body": ["input(\"${1:prompt}\")"],
    "description": "read a line from stdin"
  },

  "env": {
    "prefix": "env",
    "body": ["env(\"${1:VAR}\")"],
    "description": "read an environment variable"
  },

  "exec": {
    "prefix": "exec",
    "body": ["${1:out}, ${2:err} = exec(\"${3:command}\")"],
    "description": "run a shell command, return stdout"
  },

  "sleep": {
    "prefix": "sleep",
    "body": ["sleep(${1:ms})"],
    "description": "pause execution for ms milliseconds (integer)"
  },

  // ─── COMMON MULTI-LINE PATTERNS ──────────────────────────────────────────────
  //  Long-tail idioms that don't fit cleanly in a single-line LSP
  //  completion body. Pre-allocation respected throughout.

  "parallel fan-out": {
    "prefix": "parallel",
    "body": [
      "fn ${1:worker}(${2:i}) {",
      "\t$3",
      "}",
      "",
      "n = ${4:threads}",
      "tasks = makeArray(n, null)",
      "i = 0",
      "while i < n {",
      "\ttasks[i] = async(${1:worker}, i)",
      "\ti = i + 1",
      "}",
      "",
      "results = makeArray(n, null)",
      "j = 0",
      "while j < n {",
      "\tresults[j] = await(tasks[j])",
      "\tj = j + 1",
      "}"
    ],
    "description": "parallel fan-out using async/await + makeArray pre-allocation (no push() in the loop — see PUSH_ANTIPATTERN lint)"
  },

  "stream pipe": {
    "prefix": "pipe",
    "body": [
      "import \"stream.lex\" as s",
      "",
      "${1:result}, ${2:err} = s.pipe(",
      "\t${3:source},",
      "\ts.Filter(fn(${4:x}) { $5 }),",
      "\ts.Map(fn(${6:x}) { $7 }),",
      "\ts.collect",
      ")"
    ],
    "description": "stream pipeline using stream.lex"
  }

}
