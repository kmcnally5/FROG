{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "kLex",
  "scopeName": "source.klex",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#moduleAccess"
    },
    {
      "include": "#functionCalls"
    },
    {
      "include": "#self"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#rawStrings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.klex",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.klex",
          "match": "\\b(if|else|while|for|in|return|break|continue|switch|case|default|select)\\b"
        },
        {
          "name": "keyword.declaration.klex",
          "match": "\\bfn\\b"
        },
        {
          "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.declaration.klex"
            }
          }
        },
        {
          "name": "keyword.declaration.klex",
          "match": "\\b(struct|enum|import|as|let|const)\\b"
        }
      ]
    },
    "moduleAccess": {
      "patterns": [
        {
          "name": "variable.other.module.klex",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\.)"
        }
      ]
    },
    "functionCalls": {
      "patterns": [
        {
          "name": "entity.name.function.klex",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\()"
        }
      ]
    },
    "self": {
      "patterns": [
        {
          "name": "variable.language.klex",
          "match": "\\bself\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.klex",
          "match": "\\b(null|true|false)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.klex",
          "match": "\\b(__version__|_aesDecrypt|_aesEncrypt|_base64Decode|_base64Encode|_base64UrlDecode|_base64UrlEncode|_bcryptHash|_bcryptVerify|_constantTimeEquals|_csvFirstRowCols|_csvFormat|_csvFormatDelim|_csvHasRows|_csvParse|_csvParseDelim|_csvParseHeaders|_csvStream|_deflateCompress|_deflateDecompress|_fsAppend|_fsAppendBytesSync|_fsChmod|_fsCopy|_fsCountLines|_fsExists|_fsListDir|_fsLstat|_fsMap|_fsMkdir|_fsMkdirAll|_fsRead|_fsReadBytes|_fsReadChunk|_fsReadDir|_fsReadlink|_fsRemove|_fsRemoveAll|_fsRename|_fsStat|_fsSymlink|_fsTmpDir|_fsTmpFile|_fsTruncate|_fsWrite|_gzipCompress|_gzipDecompress|_hmacSha256|_hmacSha512|_httpDo|_httpServe|_httpStream|_imgBrightness|_imgChannelMixer|_imgContrast|_imgDesaturate|_imgExposure|_imgGamma|_imgHueShift|_imgInvert|_imgLevels|_imgSaturation|_imgSepia|_imgVignette|_iterPrep|_jsonParse|_jsonStringify|_mcpCall|_mcpClose|_mcpInfo|_mcpNotifications|_mcpNotify|_mcpServeHTTP|_mcpServerInfo|_mcpSpawn|_mcpStopServer|_md5|_mtlAccel|_mtlAccelIndexed|_mtlAccelRelease|_mtlBatchBegin|_mtlBatchCommit|_mtlBatchDispatch|_mtlBatchRelease|_mtlBuffer|_mtlBufferAllocF32|_mtlBufferAllocU32|_mtlBufferFromTensor|_mtlBufferRelease|_mtlBufferU32|_mtlClear|_mtlDispatch|_mtlFFT|_mtlInfo|_mtlKernel|_mtlKernelRelease|_mtlMatmulMPS|_mtlReadBuffer|_mtlReadBufferIntoTensor|_mtlReadBufferU32|_mtlSurface|_mtlSurfaceFromBytes|_mtlSurfaceReadRgba|_mtlSurfaceRelease|_mtlSurfaceSavePng|_osArgs|_osCwd|_osExit|_osGetenv|_osHostname|_osName|_osPid|_osSetenv|_pdfExtractByPage|_pdfExtractText|_pdfPageCount|_processExec|_processRun|_processShell|_processSpawnDetached|_randomBytes|_regexFind|_regexFindAll|_regexGroups|_regexGroupsAll|_regexMatch|_regexReplace|_regexReplaceAll|_regexSplit|_replaySeenFile|_scriptDir|_setAsyncDoneHook|_setAsyncSpawnHook|_setBridgeCallHook|_setErrorHook|_setUiEventHook|_sha256|_sha512|_tensor_abs|_tensor_abs_inplace|_tensor_add|_tensor_add_inplace|_tensor_arange|_tensor_argmax|_tensor_argmax_axis|_tensor_argmax_axis_keepdims|_tensor_argmin|_tensor_argmin_axis|_tensor_argmin_axis_keepdims|_tensor_cast|_tensor_clip|_tensor_clone|_tensor_concatenate|_tensor_contiguous|_tensor_cos|_tensor_cos_inplace|_tensor_div|_tensor_div_inplace|_tensor_dot|_tensor_dtype|_tensor_eq|_tensor_exp|_tensor_exp_inplace|_tensor_expand_dims|_tensor_eye|_tensor_from_array|_tensor_full|_tensor_ge|_tensor_get|_tensor_gt|_tensor_le|_tensor_linspace|_tensor_log|_tensor_log_inplace|_tensor_lt|_tensor_matmul|_tensor_max|_tensor_max_axis|_tensor_max_axis_keepdims|_tensor_mean|_tensor_mean_axis|_tensor_mean_axis_keepdims|_tensor_min|_tensor_min_axis|_tensor_min_axis_keepdims|_tensor_mul|_tensor_mul_inplace|_tensor_ne|_tensor_neg|_tensor_neg_inplace|_tensor_numel|_tensor_pow|_tensor_pow_inplace|_tensor_random|_tensor_reshape|_tensor_shape|_tensor_sin|_tensor_sin_inplace|_tensor_slice|_tensor_sqrt|_tensor_sqrt_inplace|_tensor_squeeze|_tensor_stack|_tensor_sub|_tensor_sub_inplace|_tensor_sum|_tensor_sum_axis|_tensor_sum_axis_keepdims|_tensor_to_array|_tensor_transpose|_tensor_where|_tensor_zeros|_timeFields|_timeFormat|_timeNanos|_timeNow|_timeParse|_tsvFormat|_tsvParse|_uiEvent|_uiEventActive|_urlDecode|_urlEncode|_uuid|abs|accordion|acos|appendFile|apply|arc|asin|assert|async|atan|atan2|atomicAdd|atomicCAS|atomicFloatArray|atomicHashAdd|atomicHashCAS|atomicHashIncr|atomicIntArray|atomicLoad|atomicStore|await|background|barChart|base64ToBytes|beginPath|bezierTo|bitAnd|bitNot|bitOr|bitShiftLeft|bitShiftRight|bitXor|blendMode|bridgeCall|bridgeClose|bridgeInfo|bridgeMetrics|bridgeNotifications|bridgePool|bridgePoolCall|bridgePoolClose|bridgePoolHealth|bridgePoolStderr|bridgePoolStream|bridgeSchema|bridgeStderr|bridgeStream|button|bytes|bytesConcat|bytesToBase64|bytesToFloats|bytesToHex|bytesToStr|cancel|ceil|channel|checkbox|chr|circle|close|closePath|colorPicker|color_bg_black|color_bg_blue|color_bg_cyan|color_bg_green|color_bg_magenta|color_bg_red|color_bg_white|color_bg_yellow|color_black|color_blue|color_bold|color_cyan|color_dim|color_green|color_magenta|color_red|color_reset|color_underline|color_white|color_yellow|colorize|concat|concatAll|concurrentHash|constrain|contextMenu|cos|cosineSim|dbBegin|dbBulkInsert|dbClose|dbCommit|dbExec|dbExecReturning|dbOpen|dbOpenWithPool|dbPing|dbQuery|dbQueryOne|dbQueryStream|dbRollback|dbSetTimeout|delete|dnsLookup|dotProduct|drawImage|drawParticles|dropdown|droppedFiles|e|elapsedTime|ellipse|endsWith|env|error|exec|exp|fill|fillPath|filter|float|floatsToBytes|floor|fmod|fontCharHeight|fontCharWidth|format|frameCount|frameRate|getTypedChars|gradient|hasKey|hexToBytes|hsl|image|imageFromRgba|imageSize|imageToRgba|indexOf|input|int|isError|join|keyDown|keyPressed|keys|label|len|lerp|line|lineChart|lineTo|list|listMulti|loadFont|loadImage|log|log10|log2|lower|makeArray|makeTheme|map|max|min|mod|modal|mouseClicked|mouseDown|mouseRightClicked|mouseRightDown|mouseScrollX|mouseScrollY|mouseX|mouseY|moveTo|nativeBridge|netClose|netRead|netWrite|noFill|noShadow|noStroke|numericStepper|ord|parallelArrayForEach|parallelArrayMap|parallelArrayReduce|parallelArrayUpdate|parseFloat|parseInt|pi|pieChart|point|polygon|pop|popClip|popMatrix|pow|print|println|progressBar|push|pushClip|pushMatrix|quadTo|quiesceLen|radio|rand|randInt|range|readFile|rect|recv|recvNonBlock|reduce|remap|replace|replaceAll|rotate|round|roundedRect|safe|saveImage|scale|scrollArea|send|shadow|shuffle|sin|sleep|slice|slider|sort|sortBy|sparkline|split|splitter|sqrt|startsWith|str|strToBytes|stroke|strokePath|strokeWeight|substr|table|tabs|tan|tcpDial|tcpListen|text|textArea|textFont|textInput|textWidth|toast|toggle|tooltip|translate|treeView|triangle|trim|type|uiBegin|uiBeginCol|uiBeginRow|uiColAdvance|uiColW|uiColX|uiColY|uiEnd|uiGetFocus|uiNextFieldID|uiResetFont|uiRowAdvance|uiRowH|uiRowX|uiRowY|uiSetFocus|uiSetFont|uiTheme|upper|values|vecNorm|winHeight|winWidth|window|writeFile)\\b(?=\\s*\\()"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.klex",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.klex",
              "match": "\\\\(?:[nrtb\"\\\\{]|x[0-9a-fA-F]{2})"
            },
            {
              "name": "meta.embedded.klex",
              "begin": "(?<!\\\\)\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.klex"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.klex"
                }
              },
              "patterns": [
                {
                  "include": "#keywords"
                },
                {
                  "include": "#constants"
                },
                {
                  "include": "#builtins"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#operators"
                }
              ]
            }
          ]
        }
      ]
    },
    "rawStrings": {
      "patterns": [
        {
          "name": "string.quoted.other.klex",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.klex",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.klex",
          "match": "(==|!=|<=|>=|&&|\\|>|\\|\\||\\.\\.\\.|[+\\-*/<>!%]|(?<![=<>!])=(?!=))"
        }
      ]
    }
  }
}
